# Sandbox image for the Claude Code peer (AGENT_CODE_PEER=claude).
#
# Build:    docker build -f Dockerfile.claude -t agent-claude .
# Runtime:  agent_runtime/claude_peer.py launches one hardened container per
#           run from this image (override the name via AGENT_CLAUDE_IMAGE).
#
# Sibling of Dockerfile.opencode, and deliberately the same shape: read-only
# rootfs at runtime, HOME=/work on a throwaway bind mount, so everything the
# agent or its generated code writes lands in /work and is persisted as
# downloadable artifacts.

FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv \
      ca-certificates curl git ripgrep unzip \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3 /usr/local/bin/python

# Pin deliberately; `latest` is fine for a sandbox that is rebuilt on purpose.
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && npm cache clean --force

# Debian's PEP-668 guard would reject pip installs; the rootfs is read-only at
# runtime anyway, so `pip install --user` (into /work/.local) is the only path
# that can work — let it.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Same preinstalled stack as the opencode sandbox, so a run that only needs the
# usual scientific libraries never waits on a per-run install.
RUN pip install --no-cache-dir numpy pandas matplotlib requests \
      libpysal esda spreg pygeoda
