# ============================================================
# OpenSearch (required)
# ============================================================
OPENSEARCH_NODE=http://your-opensearch-host:9200
OPENSEARCH_INDEX=your-index-name
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_MEMORY_INDEX=chat_memory

# ============================================================
# Embedding service (required)
# ============================================================
FLASK_EMBEDDING_URL=http://embedding-server:5000

# ============================================================
# LLM configuration (required — pick ONE backend)
# ============================================================
# -- Option A: vLLM / OpenAI-compatible proxy --
VLLM_API_KEY=your-api-key
VLLM_PROXY=http://your-vllm-endpoint/v1
VLLM_MODEL=your-model-name

# -- Option B: OpenAI / OpenAI-compatible --
OPENAI_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o

# -- Option C: AnvilGPT (legacy direct integration) --
ANVILGPT_URL=https://your-anvilgpt-url/api/chat/completions
ANVILGPT_KEY=your-api-key
ANVILGPT_MODEL=gpt-oss:120b

# ============================================================
# Vision model (optional — used by MCP image tools)
# ============================================================
VISION_API_KEY=your-vision-key
VISION_API_URL=http://your-vision-endpoint
VISION_API_MODEL=your-vision-model

# ============================================================
# Neo4j (optional — enables knowledge graph search)
# ============================================================
NEO4J_CONNECTION_STRING=bolt://your-neo4j-host:7687
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DB=neo4j
SCHEMA_CACHE_TTL_SEC=300

# ============================================================
# Spatial search (optional)
# ============================================================
GOOGLE_MAPS_API_KEY=your-google-maps-key
OPENGEODATA_NL_MODEL=gpt-4o

# ============================================================
# MCP server (optional — enables geospatial analysis tools)
# ============================================================
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_CACHE_TTL_SECONDS=60
# Comma-separated allowed hosts/origins for MCP transport security (Docker overrides these)
# MCP_ALLOWED_HOSTS=mcp-server:*,127.0.0.1:*,localhost:*
# MCP_ALLOWED_ORIGINS=http://mcp-server:*,http://127.0.0.1:*,http://localhost:*

# ============================================================
# Headless QGIS tools (optional - used by LangChain granular tools)
# ============================================================
# qgis_process executable for QGIS Processing algorithms.
QGIS_PROCESS_BIN=qgis_process
# Python executable that can import qgis.* for standalone PyQGIS tools.
# On many installs this must be the Python bundled/configured with QGIS.
QGIS_PYTHON_BIN=python
# Optional QGIS prefix path for standalone PyQGIS initialization.
# macOS example: /Applications/QGIS.app/Contents/MacOS
# QGIS_PREFIX_PATH=/path/to/qgis/prefix
# Optional PROJ/GDAL data paths when the QGIS bundle does not resolve them automatically.
# PROJ_LIB=/path/to/qgis/Resources/proj
# GDAL_DATA=/path/to/qgis/Resources/gdal
# Optional override for per-session job artifacts. Defaults to AGENT_FILE_STORAGE_ROOT/qgis_jobs.
# QGIS_JOB_ROOT=/absolute/path/to/qgis_jobs

# ============================================================
# Agent skills (optional)
# ============================================================
# Enables filesystem-backed SKILL.md bundles in skills/ and .agents/skills/.
AGENT_SKILLS_ENABLED=1
# Optional comma-separated extra skill roots. Later roots override earlier roots
# when they contain a skill with the same name.
# AGENT_SKILL_PATHS=./skills,./.agents/skills
AGENT_SKILL_MAX_RESOURCE_BYTES=65536
# LangGraph recursion limit for nested agent/tool loops.
AGENT_RECURSION_LIMIT=60

# ============================================================
# Code peer backend (optional)
# ============================================================
# Set to "opencode" to replace the LangChain code peer with a sandboxed run of
# the opencode coding agent (container-per-run; build the image first:
#   docker build -f Dockerfile.opencode -t agent-opencode .
# ). Unset/other values keep the default LangChain code peer.
# AGENT_CODE_PEER=opencode
# Defaults reuse the LLM config above (VLLM_* -> OPENAI_*); override per-peer:
# AGENT_OPENCODE_MODEL=your-model-name
# AGENT_OPENCODE_BASE_URL=http://host.docker.internal:8000/v1
# AGENT_OPENCODE_API_KEY=your-api-key
# Sandbox knobs (image, wall-clock seconds, resources, docker network):
# AGENT_OPENCODE_IMAGE=agent-opencode:latest
# AGENT_OPENCODE_TIMEOUT=600
# AGENT_OPENCODE_MEMORY=2g
# AGENT_OPENCODE_CPUS=2.0
# AGENT_OPENCODE_PIDS=1024
# AGENT_OPENCODE_NETWORK=your-compose-network

# ============================================================
# Open-web access (web_search / web_fetch)
#
# Two-step by design: web_search returns metadata only (title/url/snippet), web_fetch reads ONE
# page. Both are capped per turn, in code rather than by prompt.
# ============================================================
# Master kill switch for all open-web access (default true).
# AGENT_WEB_ENABLED=false
# Per-turn caps (defaults 3 and 3).
# AGENT_WEB_MAX_SEARCHES_PER_TURN=3
# AGENT_WEB_MAX_FETCHES_PER_TURN=3
# Discovery-stage snippet cap in characters (default 300 — snippets are for JUDGING, not answering).
# AGENT_WEB_SNIPPET_CHARS=300
# Fetch caps: bytes read from the socket, and characters of extracted text kept (defaults 2000000 / 6000).
# AGENT_WEB_MAX_BYTES=2000000
# AGENT_WEB_FETCH_MAX_CHARS=6000
# Fetched-page cache TTL in seconds (default 900; per worker process).
# AGENT_WEB_CACHE_TTL=900
# Per-request network timeout in seconds (default 12).
# AGENT_WEB_TIMEOUT=12
# Search provider and engine backend. Result quality varies by backend in BOTH directions;
# "auto" aggregates several engines, which survives any one of them rate-limiting us.
# AGENT_WEB_PROVIDER=duckduckgo
# AGENT_WEB_BACKEND=auto
# Last-resort fallback: when the I-GUIDE knowledge base returns NOTHING for a query (even after the
# refined retry), search the open web and read the top result rather than reporting no results.
# On by default; this is the only path that reaches the web without the model electing it.
# AGENT_WEB_FALLBACK=false
# Ports a page may be fetched from (default 80,443). This is the main defence for THIS deployment:
# its own services (OpenSearch :9200, embedding :5000, LLM/MCP :8000) sit on PUBLIC addresses, so a
# private-range check alone cannot protect them. Widen only if you understand that.
# AGENT_WEB_ALLOWED_PORTS=80,443

# ============================================================
# Agent chat API key (required for /agent/chat endpoints)
# Set to a strong random secret; pass as X-API-KEY header or
# Authorization: Bearer <key> from the frontend/client.
# ============================================================
AGENT_CHAT_API_KEY=your-agent-chat-api-key

# ============================================================
# Agent file storage
# ============================================================
AGENT_FILE_STORAGE_ROOT=./agent_chat_files
UPLOAD_FOLDER=./agent_chat_files/uploads

# ============================================================
# MinIO (optional — metadata-extraction-server)
# ============================================================
MINIO_ENDPOINT_URL=http://your-minio-host:9000
MINIO_ACCESS_KEY_ID=your-access-key
MINIO_ACCESS_KEY=your-secret-key

# ============================================================
# Feature flags
# ============================================================
SPATIAL_BACKEND_ENABLED=1
SEMANTIC_BACKEND_ENABLED=1
USE_LLM_ROUTING=1

# ============================================================
# Memory / chat history
# ============================================================
MEMORY_EMBEDDER_MODEL=all-MiniLM-L6-v2
MEMORY_CONTEXT_THRESHOLD=0.35

# ============================================================
# ColBERT reranker (optional)
# ============================================================
COLBERT_SKIP_CPP=1

# ============================================================
# LangSmith tracing (optional)
# ============================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=i-guide-agent

# ============================================================
# Server / misc
# ============================================================
PORT=5002
FRONTEND_DOMAIN=http://localhost:3000
LOG_LEVEL=INFO

# --- the agent's own Postgres record (extractors/kb_db.py) -------------------------
# OpenSearch and Neo4j above belong to the website. This is the store the agent owns: the
# record its indices are built from, and the one place a slice and the contract describing it
# are written together. Optional — leave AGENT_KB_DB unset and every existing path is unchanged.
AGENT_DB_PASSWORD=change-me
AGENT_DB_USER=iguide
AGENT_DB_NAME=iguide_agent
AGENT_DB_PORT=5544
# Read path. `1` routes kb_method_search / get_method_contract at Postgres; unset uses the
# on-disk method-library registry, which stays the fallback if the database is unreachable.
AGENT_KB_DB=
AGENT_KB_DSN=postgresql://iguide:change-me@127.0.0.1:5544/iguide_agent
